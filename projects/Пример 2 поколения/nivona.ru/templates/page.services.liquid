<div class="page-services content-wrapper">

      <div class="container">

          <div class="row">

              <div class="col-xs-12">

                <div class="page-services__heading">

                    <div class="page-services__heading__title">

                        {{ page.title | editable }}

                    </div>

                    <div class="page-services__heading__subtitle">

                        Выберите модель вашей техники

                    </div>

                </div>

                <div class="page-services__products">

                    <div class="row">

                        {% for block in block_lists.widget-services.blocks %}

                            <div class="col-xs-6 col-sm-4 col-md-3">

                                <div class="page-services__products__item js-services-product-item" data-title="{{ block.product_title }}" data-image="{{ block.image }}">

                                    <div class="page-services__products__item__image">

                                        <img src="{{ block.image }}" />

                                    </div>

                                    <div class="page-services__products__item__title">

                                        {{ block.product_title }}

                                    </div>

                                    <div class="js-problems-list" style="display: none;">

                                        {% assign problems = block.problems_handle | split: '||' %}

                                        {% for problem in problems %}

                                            <div class="col-xs-6 col-sm-4 col-md-3">

                                                <div class="page-services__problems__item">

                                                    <div class="page-services__problems__item__title">{{ blocks[problem].title }}</div>

                                                </div>

                                            </div>

                                        {% endfor %}

                                    </div>

                                </div>

                            </div>

                        {% endfor %}

                    </div>

                </div>

                <div class="page-services__product" style="display: none">

                    <div class="page-services__product__item">

                        <div class="page-services__product__item__image">

                            <img src="{{ block.image }}" />

                        </div>

                        <div class="page-services__product__item__title">

                            {{ block.product_title }}

                        </div>

                    </div>

                </div>

                <div class="page-services__problems" style="display: none">

                    <div class="page-services__problems__title">В чем заключается проблема?</div>

                    <div class="page-services__problems__items row">



                    </div>

                </div>

                <div class="page-services__feedback" style="display: none">

                    <div class="page-services__feedback__title">Оставьте свои контактные данные и специалист свяжется с вами</div>

                    <div class="page-services__feedback__form">

                        <div class="js-services-feedback-success" style="display:none; padding: 1rem; background: #e8f5e9; color: #2e7d32; border-radius: 4px; margin-bottom: 1rem; font-size: 1rem;">

                          Заявка успешно отправлена!

                        </div>

                        <form class="feedback-form form js-widget-services-feedback" action="/client_account/feedback" accept-charset="UTF-8" method="post" data-feedback-form-wrapper>

                            <div class="form-block">

                                <input id="feedback_subject_ser" type="hidden" name="subject" value="" />

                                <input type="hidden" name="feedback[from]" value="{{ account.email }}" />



                                <div class="form-row-header">

                                  <div class="form-row is-required is-text" data-feedback-form-field-area>

                                    <input type="text" name="name" value="" class="form-field is-text" placeholder="Ваше имя"

                                      data-feedback-form-field='{"isRequired": true, "errorMessage": "Введите имя"}'>

                                    <div data-feedback-form-field-error class="form-notice is-error"></div>

                                  </div>

                                  <div class="form-row is-required is-text" data-feedback-form-field-area>

                                    <input type="text" name="phone" value="" class="form-field is-text" placeholder="+ 7 999 999 99 99"

                                      data-feedback-form-field='{"isRequired": true, "errorMessage": "Введите телефон", "phoneNumberLength": 11, "secondPhoneNumberLength": 12}'>

                                    <div data-feedback-form-field-error class="form-notice is-error"></div>

                                  </div>

                                  <div class="form-row is-required is-text" data-feedback-form-field-area>

                                    <input type="text" name="from" value="" class="form-field is-text" placeholder="Email"

                                      data-feedback-form-field='{"isRequired": true, "errorMessage": "Введите email"}'>

                                    <div data-feedback-form-field-error class="form-notice is-error"></div>

                                  </div>

                                </div>

                                <div class="form-row is-required is-textarea" data-feedback-form-field-area>

                                    <textarea class="form-field is-textarea" name="content" placeholder="Комментарий"

                                      data-feedback-form-field='{"isRequired": true, "errorMessage": "Введите комментарий"}'></textarea>

                                    <div data-feedback-form-field-error class="form-notice is-error"></div>

                                </div>



                                <div class="form-row form-consent is-checkbox">

                                  <div class="form__group form__group--regulations" data-feedback-form-field-area>

                                    <input class="form__checkbox-input" type="checkbox" id="services_consent" name="consent_to_personal_data" value="agree"

                                      data-feedback-form-agree='{"errorMessage": "Необходимо подтвердить согласие"}'>

                                    <label for="services_consent" class="form__checkbox-label">

                                      <span>Настоящим подтверждаю, что <a href="/page/soglasie-na-obrabotku-personalnyh-dannyh" target="blank">согласен</a> на обработку персональных данных</span>

                                    </label>

                                    <div data-feedback-form-field-error class="form-notice is-error"></div>

                                  </div>

                                </div>



                                <div class="form-row is-required is-captcha" data-feedback-form-field-area>

                                  <div data-yandex-captcha-type="visible"

                                    data-feedback-form-yandex-captcha='{"isRequired": true, "errorMessage": "Пожалуйста, подтвердите, что вы не робот"}'

                                    class="feedback__yandex-captcha"></div>

                                  <div data-feedback-form-field-error class="form-notice is-error feedback__field-error"></div>

                                </div>



                                <div class="form-row">

                                    <div class="form-controls">

                                        <button type="submit" class="form-button button is-primary">

                                            Отправить заявку

                                        </button>

                                    </div>

                                  </div>

                              </div>

                        </form>

                    </div>

                </div>

              </div>

          </div>

      </div>

  </div>

