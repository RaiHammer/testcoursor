<!DOCTYPE html>
<html lang="ru">
  <head>
    {% include "head" %}
{% comment %} <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet"> {% endcomment %}
  </head>

  <body class="fhg-body {{ template }}">
    {% include 'preloader' %}

    {% include "no_js_alert" %}
    {% include "header" %}

    {{ content_for_layout }}
	  {% include 'svg' %}
    {% include "footer" %}
    {% include "modals" %}
    {% include "scripts" %}
    {% include 'analytics' %}

    {% comment %} {% include 'popup_prod-registr' %}
    <script src="{{ 'page.js' | asset_url }}" charset="utf-8"></script> {% endcomment %}

    {% comment %} {% if template == 'page' or template == 'page.product_registration' %}
    {% endif %} {% endcomment %}

<script>
var owl = $('.owl-carousel');
owl.on('changed.owl.carousel', function(event) {
  	//console.log(event)
    //console.log(event.currentTarget)
  	$(event.currentTarget).find('.owl-item.active').each(function(){
		var _this = $(this).next();
		var img = _this.find('img').attr('data-original');
      	_this.find('img').attr('src',img)
})
//	var img = $(event.currentTarget).find('img').attr('data-original');
//  	$(event.currentTarget).find('img').attr('src',img)
})
</script>
  </body>
</html>
