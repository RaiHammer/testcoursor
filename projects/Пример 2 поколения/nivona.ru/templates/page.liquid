<div class="content-wrapper">
  {% include "page_header" %}
	<div class="container">
		<div class="row">
			<div class="col-xs-12">
          {% if page.url contains 'feedback' %}
            <div class="js-feedback-success" style="display:none; padding: 1rem; background: #e8f5e9; color: #2e7d32; border-radius: 4px; margin-bottom: 1rem; font-size: 1rem;">
              Сообщение успешно отправлено!
            </div>
            <form class="form js-form-feedback" action="/client_account/feedback" accept-charset="UTF-8" method="post" data-feedback-form-wrapper>
              <div class="form-row is-required is-text" data-feedback-form-field-area>
                <div class="form-label is-required is-text">Email</div>
                <input class="form-field is-text" type="email" name="from" value="" placeholder=""
                  data-feedback-form-field='{"isRequired": true, "errorMessage": "Введите email"}'>
                <div data-feedback-form-field-error class="form-notice is-error"></div>
              </div>
              <div class="form-row is-required is-textarea" data-feedback-form-field-area>
                <div class="form-label is-required is-textarea">Сообщение</div>
                <textarea class="form-field is-text is-textarea" name="content" placeholder=""
                  data-feedback-form-field='{"isRequired": true, "errorMessage": "Введите сообщение"}'></textarea>
                <div data-feedback-form-field-error class="form-notice is-error"></div>
              </div>
              <div class="form-row is-required is-checkbox">
                <div class="form__group form__group--regulations" data-feedback-form-field-area>
                  <input class="form__checkbox-input" type="checkbox" id="feedback_page_consent" name="consent_to_personal_data" value="agree"
                    data-feedback-form-agree='{"errorMessage": "Необходимо подтвердить согласие"}'>
                  <label for="feedback_page_consent" class="form__checkbox-label">
                    <span>Настоящим подтверждаю, что <a href="/page/soglasie-na-obrabotku-personalnyh-dannyh" target="blank">согласен</a> на обработку персональных данных</span>
                  </label>
                  <div data-feedback-form-field-error class="form-notice is-error"></div>
                </div>
              </div>
              <div class="form-row is-required is-captcha" data-feedback-form-field-area>
                <div data-yandex-captcha-type="visible"
                  data-feedback-form-yandex-captcha='{"isRequired": true, "errorMessage": "Пожалуйста, подтвердите, что вы не робот"}'
                  class="feedback__yandex-captcha"></div>
                <div data-feedback-form-field-error class="form-notice is-error feedback__field-error"></div>
              </div>
              <div class="form-controls-wrapper">
                <div class="form-controls">
                  <button class="button is-primary" type="submit">Отправить</button>
                </div>
              </div>
              <input type="hidden" name="subject" value="Сообщение с сайта">
              <input type="hidden" name="feedback[from]" value="{{ account.email }}">
            </form>
          {% elsif page.url contains 'serial' %}
            {% include 'page-serial' %}
          {% elsif page.url contains 'service-centers' %}
            {% include 'page-service-centers' %}
          {% else %}
            <div class="editor">
              {{ page.content | editable }}
            </div>
          {% endif %}
			</div>
		</div>
	</div>
</div>

{% if page.handle == "servis-i-podderzhka" %}
  {% comment %}//XXX кнопку можно добавить в редакторе страницы  {% endcomment %}
  <div style="display: none">
    {% if client %}
      <button class="sc-feedback popup-button" id="sc-feedback" popup-button popup-content="form" enctype="multipart/form-data">Регистрация продукта</button>
    {% else %}
      <button class="popup-modal sc-feedback popup-button" id="sc-feedback" data-attr="#signin">Регистрация продукта</button>
      {% comment %} <a href="/client_account/login" class="popup-modal sc-feedback" id="sc-feedback" data-attr="#signin">{{ link.title }}</a> {% endcomment %}
    {% endif %}
  </div>
{% endif %}