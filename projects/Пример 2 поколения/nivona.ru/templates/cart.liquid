                  </svg>
                </div>
                <span class="sale-title__text">Доступные акции</span>
              </div>

              <div class="sale-items">
                {% for block in block_lists.block-sale-panel.blocks %}
                  {% if block.show-sale %}
                    <span class="sale-item">{{ block.text-sale }}</span>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </section>

        <div class="col-xs-12 col-sm-12 col-md-9">
          <div class="section-related-products js-section_reviews_products">
            <div class="section-related-products__title">
              Необходимые товары
            </div>

            <div class="section-related-products__items products-list">
              {% assign products_ids_tmp = '' %}
              {% assign show_related = false %}
              <div class="products-items products-items_grid active">
                <div class="products-list is-cart row">
                  {% for item in cart.items %}
                    {% for product in item.product.related_products limit: 10 %}
                      {% unless products_ids_tmp contains product.id or product.available == false %}
                        {% capture products_ids_tmp %}{{ products_ids_tmp }}|{{ product.id }}|{% endcapture %}
                        {% assign show_related = true %}
                        <div class="col-xs-6 col-sm-6 col-md-12">
                          {% include 'product_card' %}
                        </div>
                      {% endunless %}
                    {% endfor %}
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
          {% assign product_limit = null %}
        </div>
    </div>
  </div>
{% else %}
  <div class="container content-wrapper">
    <div class="row">
      <div class="col-xs-12">
        <div class="cart-empty">
          <div class="cart-empty__title">В вашей корзине пока нет товаров</div>
          <div class="cart-empty__descr">Акции и предложения, каталог товаров, новости и многое другое вы сможете найти на главной странице</div>
          <div class="cart-empty__btn">
            <a href="/" class="button is-primary">На главную</a>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}