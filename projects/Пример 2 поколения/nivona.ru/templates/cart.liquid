{% if cart.items.size > 0 %}
	{% include "page_header" %}
  
  <div class="container cart-items-page">
		<div class="row">
        <div id="custom_form" class="col-xs-12 col-sm-12 col-md-9">
          <div class="content-item--no-padd" id="basket">
            <div class="basket-product-list">
              <form class="checkout" action="/cart_items" method="post" data-cart-form>
                {% for item in cart.items %}
                    {% include 'cart-item' %}
                {% endfor %}
              </form>
              <div class="basket-product-list-load"></div>
            </div>
            <div class="basket-total basket-total--show-mb">
              <div class="basket-total__title">Итого:</div>
              <div class="basket-total__price"></div>
            </div>
          </div>
        </div>

        <section id="checkout-sidebar" class="checkout-sidebar col-xs-12 col-sm-12 col-md-3">
          <div class="checkout-sidebar-wrapper">
            <div class="checkout-sidebar-block">
              <div class="order-title">
                Сумма заказа
              </div>
              <div class="order-items" id="order_complete">
                {% if cart.enable_coupon? %}
                        <div class="formPromo" id="coupon">
                            <div class="order-item formPromo__field fieldInput" id="js-coupon-wrapper">
                              <input class="formPromo__input discount-input" type="text" placeholder="Промокод" name="cart[coupon]" value="{{ cart.coupon }}">
                              <button type="submit" class="formPromo__submit discount-button button" {% if cart.coupon.size > 0 %} style="display: none;"{% endif %} data-coupon-submit>Применить</button>
                              <button type="button" class="formPromo__remove discount-button button" {% if cart.coupon.size > 0 %} style="display: block;"{% endif %} data-coupon-remove>Очистить</button>
                            </div>
                            <div class="formPromo__title-error">Промокод не верный</div>
                        </div>
                {% endif %}
                
                {% comment %}
                <div class="co-basket_subtotal order-item order-item--bold itemsQuantity">
                  <div class="co-basket_subtotal-title">Товаров</div>
                  <div class="co-basket_subtotal-price order-item__number" id="items_quantity">
                    <span class="js-cart-items-count active">{{ cart.items_count }}</span>&nbsp;шт.
                  </div>
                </div>
                {% endcomment %}
                
                <div class="co-basket_discount order-item">
                  <div class="co-basket_discount-title">Скидки по товарам</div>
                  <div class="co-basket_discount-prices">
                    <div class="co-basket_discount-price co-price--current order-item__number js-cart-items-discount-price"></div>
                    <div class="co-basket_discount-price-percent co-price-percent--current order-item__number js-cart-items-discount-percent"></div>
                  </div>
                </div>

                <div class="co-basket_subtotal order-item">
                  <div class="co-basket_subtotal-title">Товары</div>
                  <div class="co-basket_subtotal-price co-price--current order-item__number js-cart-items-price">{{ cart.items_price | money }}</div>
                </div>

                {% include 'cart_discount' %}

                <div class="co-basket_total order-item">
                  <div class="co-basket_total-title">К оплате:</div>
                  <div class="co-basket_total-price co-price--current order-item__number js-cart-total-price">{{ cart.total_price | money }}</div>
                </div>

                <div class="order-item checkout-sidebar-button">
                  <a href="/new_order" class="button is-primary complate-checkout">Оформить заказ</a>
                </div>
              </div>
            </div>

            <div class="checkout-sidebar-block block-sale">
              <div class="sale-title">
                <div class="sale-title__icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M7.76513 0.998648C8.04647 0.684442 8.39091 0.433097 8.77596 0.261019C9.16101 0.0889416 9.57803 0 9.99978 0C10.4215 0 10.8385 0.0889416 11.2236 0.261019C11.6087 0.433097 11.9531 0.684442 12.2344 0.998648L12.9343 1.78052C13.0343 1.89241 13.1583 1.98035 13.2969 2.03781C13.4355 2.09528 13.5853 2.12079 13.7352 2.11247L14.785 2.05448C15.206 2.03136 15.6271 2.09725 16.0209 2.24785C16.4147 2.39845 16.7724 2.63038 17.0705 2.92851C17.3686 3.22664 17.6005 3.58427 17.7512 3.97807C17.9018 4.37187 17.9676 4.793 17.9445 5.21398L17.8865 6.26381C17.8784 6.4135 17.9039 6.5631 17.9614 6.70155C18.0189 6.84001 18.1067 6.96377 18.2185 7.06369L19.0014 7.76358C19.3157 8.04492 19.5672 8.38941 19.7394 8.77456C19.9116 9.15971 20.0006 9.57684 20.0006 9.99872C20.0006 10.4206 19.9116 10.8377 19.7394 11.2229C19.5672 11.608 19.3157 11.9525 19.0014 12.2339L18.2185 12.9338C18.1066 13.0338 18.0187 13.1577 17.9612 13.2963C17.9037 13.435 17.8782 13.5848 17.8865 13.7346L17.9445 14.7845C17.9676 15.2054 17.9018 15.6266 17.7512 16.0204C17.6005 16.4142 17.3686 16.7718 17.0705 17.0699C16.7724 17.3681 16.4147 17.6 16.0209 17.7506C15.6271 17.9012 15.206 17.9671 14.785 17.944L13.7352 17.886C13.5855 17.8778 13.4359 17.9034 13.2974 17.9608C13.159 18.0183 13.0352 18.1062 12.9353 18.2179L12.2354 19.0008C11.9541 19.3152 11.6096 19.5667 11.2244 19.7388C10.8393 19.911 10.4222 20 10.0003 20C9.5784 20 9.16126 19.911 8.77612 19.7388C8.39097 19.5667 8.04648 19.3152 7.76513 19.0008L7.06524 18.2179C6.96522 18.106 6.8413 18.0181 6.70266 17.9606C6.56402 17.9032 6.41422 17.8776 6.26437 17.886L5.21454 17.944C4.79356 17.9671 4.37243 17.9012 3.97863 17.7506C3.58482 17.6 3.22719 17.3681 2.92907 17.0699C2.63094 16.7718 2.39901 16.4142 2.24841 16.0204C2.09781 15.6266 2.03192 15.2054 2.05504 14.7845L2.11303 13.7346C2.1212 13.5849 2.09561 13.4353 2.03815 13.2969C1.98069 13.1584 1.89284 13.0347 1.78108 12.9348L0.999207 12.2349C0.684836 11.9535 0.433349 11.609 0.261172