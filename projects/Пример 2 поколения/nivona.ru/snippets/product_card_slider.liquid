
                              <form class="product-cart-control {{ hidden_form }}" method="post" action="{{ cart_url }}" data-product-id="{{ product.id }}" data-main-form
                                 data-product-item data-item-sku="{{ product.sku }}" data-item-title="{{ product.title | escape | replace: '"', '&quot;' | replace: "'", "&prime;" }}" 
                                 data-item-collection="{{ product.collections.first.title | replace: '"', '&quot;' | replace: "'", "&prime;" }}" 
                                 data-item-brand="{{ product.properties.brend.characteristics.first.title | replace: '"', '&quot;' | replace: "'", "&prime;" }}" 
                                 data-item-price="{{ product.price }}" data-item-currency="RUB" 
                                 data-item-variant="{{ product.variants[0].title | replace: '"', '&quot;' | replace: "'", "&prime;" }}" data-item-url="{{ product.url | escape }}">
                                <input type="hidden" name="variant_id" value="{{ product.variants.first.id }}">
                                <input type="hidden" name="quantity" class="counter-input input-number input-field" value="1"/>
                                <div class="product-card">
                                    <button class="product-card__add js-compare-add" data-toggle="tooltip" data-placement="bottom" title="Сравнить" data-compare-add="{{ product.id }}" aria-label="Сравнить"></button>
                                    <button class="product-card__add js-compare-delete" data-toggle="tooltip" data-placement="bottom" title="Удалить из сравнения" data-compare-delete="{{ product.id }}" style="display: none;" aria-label="Удалить из сравнения"></button>

                                    <a href="{{ product.url }}" data-product-url>
                                      <picture>
                                        <source srcset="{{ product.first_image | image_url: 350, format: 'webp' }}" type="image/webp">
                                        <img src="{{ product.first_image | image_url: 350 }}" alt="{{ product.title }}" width="350" height="350" loading="lazy">
                                      </picture>
                                    </a>
                                    <div class="product-card__meta">
                                        <a href="{{ product.url }}" data-product-url><span class="product-card__title">{{ product.title }}</span></a>
                                        {% comment %}<span class="product-card__model"></span>{% endcomment %}
                                        <span class="product-card__price">{{ product.price | money }}</span>
                                      	{% if product.old_price > product.price %}<span class="product-card__old_price">{{ product.old_price | money }}</span>{% endif %}
                                        <!-- Если больше 1 модификации -->
                                        {% if product.variants.size > 1 %}
                                          <a class="product-card__btn" onclick="ym(48352907,'reachGoal','klik_po_knopke_kupit'); return true;" href="{{ product.url }}" title='{{ product.title }}' data-product-url></a>

                                        <!-- product.quantity больше 0 -->
                                        {% elsif product.available %}
                                          <button class="product-card__btn" onclick="ym(48352907,'reachGoal','klik_po_knopke_kupit'); return true;" type="submit" data-item-add></button>

                                        <!-- product.quantity == 0 -->
                                        {% elsif settings.product_not_available contains 'shown' %}
                                            <button class="product-card__btn winbox  button is-primary" data-window="{% if settings.product_order_target == 'mail' %}request{% else %}quickorder|request{% endif %}" data-product-title="{{ product.title | escape }}" data-window-product-url="{{ account.url }}{{ product.canonical_url }}" data-variant-id="{{ product.variants.first.id }}" data-variant-price="{{ product.variants.first.price }}" data-variant-image="{{ product.first_image.original_url }}" data-product-id="{{ product_id }}">
                                              <span class="button-text">{% if product.properties['is_preorder'].characteristics[0].handle == 'true' %}Предзаказ{% else %}{{ settings.product_order_text }}{% endif %}</span>
                                            </button>
                                        {% else %}
                                            <a class="product-card__btn" onclick="ym(48352907,'reachGoal','klik_po_knopke_kupit'); return true;" href="{{ product.url }}" title='{{ product.title }}' data-product-url></a>
                                        {% endif %}
                                    </div>
                                </div>
                              </form>
