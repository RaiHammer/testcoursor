{% assign canon =  null %}

{% comment %} <meta name="facebook-domain-verification" content="v7vkci5bfeytqu8fcdmn7y4a1wi208" /> {% endcomment %}

{% unless template == 'checkout' %}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {% if template == 'product' %}
    {% if product.images.size > 0 %}
      <link rel="preload" as="image" href="{{ product.images.first | image_url: 800, format: 'webp' }}" fetchpriority="high">
    {% endif %}
  {% endif %}
  {% if template == 'collection' %}
    {% if collection.products.size > 0 %}
      {% if collection.products.first.first_image %}
        <link rel="preload" as="image" href="{{ collection.products.first.first_image | image_url: 350, format: 'webp' }}" fetchpriority="high">
      {% endif %}
    {% endif %}
  {% endif %}
  {% if template == 'index' %}
    {% for block in block_lists.index-widget-slider-new.blocks limit: 1 %}
      {% unless block.hide %}
        {% if block.image-375.size > 0 %}
          <link rel="preload" as="image" href="{{ block.image-375 | image_url: 480, format: 'webp', resizing_type: 'fit_width', quality: 90 }}" media="(max-width: 480px)" fetchpriority="high">
        {% elsif block.image.size > 0 %}
          <link rel="preload" as="image" href="{{ block.image | image_url: 600, format: 'webp', resizing_type: 'fit_width', quality: 90 }}" media="(max-width: 480px)" fetchpriority="high">
        {% endif %}
        <link rel="preload" as="image" href="{{ block.image | image_url: 1980, format: 'webp', resizing_type: 'fit_width', quality: 90 }}" media="(min-width: 481px)" fetchpriority="high">
      {% endunless %}
    {% endfor %}
  {% endif %}
  <script src="{{ 'jquery-2.2.4.min.js' | asset_url }}"></script>
  {% include_insales_scripts "common-js@v2" %}
{% endunless %}

