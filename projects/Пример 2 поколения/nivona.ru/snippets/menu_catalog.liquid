{% assign show_icon = show_icon | default: false %}

{% capture cache_menu_key %}cache_menu_key_{{ collections.last_updated_at }}_{{ menu_class }}_{{ show_icon }}_{{ source_handle }}_{{ languge.local }}{% endcapture %}

{% cache cache_menu_key %}
  {% assign level_1 = collections[source_handle].subcollections %}
  <ul class="{{ menu_class }} menu level-1" data-menu-id="{{ menu_class }}">

    {% for level_1_item in level_1 %}
      {% assign level_2 = level_1_item.subcollections %}

      <li class="{{ menu_class }}-item menu-item level-1">
        <div class="{{ menu_class }}-item-controls menu-item-controls level-1">
          {% if show_icon %}
            <span class="{{ menu_class }}-icon menu-icon"></span>
          {% endif %}

          <a href="{{ level_1_item.url }}" class="{{ menu_class }}-link menu-link level-1" data-menu-link="{{ level_1_item.handle }}" data-menu-link-source="collection">
            {{ level_1_item.title }}
          </a>

          {% if level_2.size > 0 %}
            <button class="{{ menu_class }}-marker menu-marker" type="button"></button>
          {% endif %}
        </div>

        {% if level_2.size > 0 %}
          <ul class="{{ menu_class }} menu">
            {% for level_2_item in level_2 %}
            {% assign level_3 = level_2_item.subcollections %}

            <li class="{{ menu_class }}-item menu-item level-1">
              <div class="{{ menu_class }}-item-controls menu-item-controls level-1">
                {% if show_icon %}
                  <span class="{{ menu_class }}-icon menu-icon"></span>
                {% endif %}

                <a href="{{ level_2_item.url }}" class="{{ menu_class }}-link menu-link level-1" data-menu-link="{{ level_2_item.handle }}" data-menu-link-source="collection">
                  {{ level_2_item.title }}
                </a>

                {% if level_3.size > 0 %}
                  <button class="{{ menu_class }}-marker menu-marker" type="button"></button>
                {% endif %}
              </div>

              {% if level_3.size > 0 %}
                <ul class="{{ menu_class }} menu">
                  {% for level_3_item in level_3 limit: 6 %}

                  <li class="{{ menu_class }}-item menu-item level-1">
                    <div class="{{ menu_class }}-item-controls menu-item-controls level-1">
                      {% if show_icon %}
                      <span class="{{ menu_class }}-icon menu-icon"></span>
                      {% endif %}

                      <a href="{{ level_3_item.url }}" class="{{ menu_class }}-link menu-link level-1" data-menu-link="{{ level_3_item.handle }}" data-menu-link-source="collection">
                        {{ level_3_item.title }}
                      </a>
                    </div>
                  </li>
                  {% endfor %}

                  {% if level_3.size > 6 %}
                    <li class="{{ menu_class }}-item menu-item level-1">
                      <div class="{{ menu_class }}-item-controls menu-item-controls level-1">
                        {% if show_icon %}
                          <span class="{{ menu_class }}-icon menu-icon"></span>
                        {% endif %}

                        <a href="{{ level_2_item.url }}" class="{{ menu_class }}-link menu-link level-1 all-subcategory" data-menu-link="{{ level_2_item.handle }}" data-menu-link-source="collection">
                          {{ messages.all_subcategory }}
                        </a>
                      </div>
                    </li>
                  {% endif %}
                </ul>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endcache %}

{% assign source_handle = null %}
{% assign menu_class = null %}
{% assign show_icon = null %}
