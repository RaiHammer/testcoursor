{% if template == 'account.orders' or template == 'account' or template == 'page.services' or template == 'page.product_registration' %}
	{% if client %}
			{% assign menu_source = 'header-menu-cabinet' %}
		{% else %}
			{% assign menu_source = 'header-menu' %}
	{% endif %}
{% else %}
	{% if template == 'order' and client %}
		{% assign menu_source = 'header-menu-cabinet' %}
	{% else %}
		{% assign menu_source = 'header-menu' %}
	{% endif %}
{% endif %}
<div class="header_menu {{ menu_source }}">
	<div class="container">
		<div class="header_menu_control js-open-header_menu">{% if menu_source == 'header-menu-cabinet' %}Меню{% else %}{% if template == 'collection' %}{{ collection.title }}{% else %}Каталог{% endif %}{% endif %}</div>
		<div class="header_menu_wrap">
		{% for link in linklists[menu_source].links %}
			{% assign current_class = '' %}
			{% if link.current? %}
				{% assign current_class = 'active' %}
			{% endif %}
			<div class="header_menu_item {{ current_class }}">
				<a href="{{ link.url }}">
					<div class="icon">
						{% case link.title %}
							{% when 'Кофемашины' %}
								<svg width="40" height="44"><use xmlns:xlink="//www.w3.org/1999/xlink" xlink:href="#coffee-maker" fill="#000"></use></svg>
							{% when 'Кофемолка' %}
								<svg width="22" height="41"><use xmlns:xlink="//www.w3.org/1999/xlink" xlink:href="#coffee-grinder" fill="#000"></use></svg>
							{% when 'Кофе' %}
								<svg width="32" height="41"><use xmlns:xlink="//www.w3.org/1999/xlink" xlink:href="#coffee" fill="#000"></use></svg>
							{% when 'Аксессуары' %}
								<svg width="23" height="47"><use xmlns:xlink="//www.w3.org/1999/xlink" xlink:href="#coffee-aks" fill="#000"></use></svg>
							{% when 'О бренде' %}
								<svg width="36" height="36"><use xmlns:xlink="//www.w3.org/1999/xlink" xlink:href="#megaphone" fill="#000"></use></svg>
							{% when 'Кофейная культура' %}
								<svg width="36" height="36"><use xmlns:xlink="//www.w3.org/1999/xlink" xlink:href="#coffee-hot" fill="#000"></use></svg>
						{% endcase %}
					</div>
					<div class="title">
						{{ link.title }}
					</div>
				</a>
			</div>
		{% endfor %}
		</div>
	</div>
</div>
