{% comment %} ODX-3339  {% endcomment %}
{% assign main_phone = account.phone %}

{% if template == "collection" and collection.id == 46708225 %}
	{% assign main_phone = "+7 963 683 62 32" %}
{% endif %}

{% if template == "product" and product.canonical_collection.id == 46708225 %}
	{% assign main_phone = "+7 963 683 62 32" %}
{% endif %}

{% if template == "cart" or template == "checkout" and cart.items_count > 0 %}
	{% for item in cart.items %}
		{% if item.product.canonical_collection.id == 46708225 %}
			{% assign main_phone = "+7 963 683 62 32" %}
			{% break %}
		{% endif %}
	{% endfor %}
{% endif %}

<div class="top_line">
	<div class="container">
		<div class="top_line_panel__mobile">
			<div class="top_line_panel__mobile__logo">
				<a href="/" class="top_line_panel__mobile__logo__link">
					{% if settings.ny_show == '1' %}
						<img src="{{ 'nivona-ny-logo-mobile_2x.png' | asset_url }}" alt="Nivona">
					{% else %}
						<img src="{{ 'logo_new_mobile.svg' | asset_url }}" alt="Nivona">
					{% endif %}
					{% comment %} <img src="{{ 'logo-ny.png' | asset_url }}"> {% endcomment %}
				</a>
			</div>
			<div class="top_line_panel__mobile__controls">
				{% unless settings.phone_hide == '1' %}
					<div class="top_line_panel__mobile__controls__phone" > 
						<a href="tel:{{- main_phone | replace: ' ', '' -}}">
							<svg width="16" height="16"><use xmlns:xlink="//www.w3.org/1999/xlink" xlink:href="#phone_c"></use></svg>
							<span>{{ main_phone }}</span> 
						</a>
						<!--Для внесения срочной инфы МОБИЛЬНЫЕ <p align="right">К сожалению, по техническим причинам, телефон в данный момент не работает. Просьба оставлять заявки и заказы через систему на сайте.</p>-->
					</div>
				{% endunless %}
				<div class="top_line_panel__mobile__controls__burger">
					<button class="header__btn" aria-label="Открыть меню">
						<span></span>
						<span></span>
						<span></span>
					</button>
				</div>
			</div>
		</div>
		<div class="top_line_panel">
			<div class="left_top_line">
				<div class="top_city_wrap">
				{% if settings.geo_active and settings.header_geo %}
					<div class="header__geo">
					  <script>
						var geo_active = {% if settings.geo_active %}true{% else %}false{% endif %};
					  </script>
					  <div class="geo-city-header">
						<div class="geo-city js-geo-city"></div>
						{% if settings.header_geo_popup %}
						  <div id="minigeo" class="minigeo header-icons-item-popup js-minigeo">
							<div class="header-icons-item-popup-content">
							  <p><span class="js-geo-city-popup">Город доставки ваших покупок<br><strong>&hellip;</strong>?</span></p>
							  <div class="minigeo_buttons">
								  <button class="button is-primary js-minigeo-toggle">Да, все верно</button>
								  <button class="button is-bordered winbox" data-window="geo|geoCity">Нет, сменить город</button>
							  </div>
							</div>
						  </div>
						{% endif %}
					  </div>
					</div>
				  {% endif %}
				</div>
				<div class="top_left_menu">
					{% for link in linklists.top-menu.links %}
						{% if settings.prod_sale_off == '1' or settings.cards_sale_off == '1' %}
							{% unless link.title == 'Акции' %}
											<div class="left_menu_item">
													<a href="{{ link.url }}">{{ link.title }}</a>
											</div>
							{% endunless %}
						{% elsif link.title == 'Все акции' %}
							<div class="left_menu_item left_menu_item_expand">
								<a class="left_menu_item_expand-link" href="{{ link.url }}">
									<span class="left_menu_item_expand-icon">
