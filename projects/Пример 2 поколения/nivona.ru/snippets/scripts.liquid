<script>
  {% if template == 'article' %}
    /* Комментирование статтей */
    $(function () {
      var _commentForm = {
        fields: [
          {
            title: '{{ messages.field_comment }}',
            name: 'content',
            type: 'textarea',
            required: true,
          },
          {
            title: '{{ messages.field_name }}',
            name: 'author',
            required: true,
          },
          {
            title: '{{ messages.field_email }}',
            name: 'email',
            required: true,
          },
          {% if comment.captcha_enabled? %}
          {
            title: '{{ messages.field_captcha }}',
            type: 'captcha',
            required: true,
          }
          {% endif %}
        ],
        sendTo: Shop.sendComment,
        messages: {
          success: '{{ messages.comment_success }}'
        },
        onValid: function (response, form) {
          var $notice = $('.js-comments-notice-success');
          var $commentsList = $('[data-comments-list]');

          // alertify.success('{{ messages.comment_success }}');

          $notice.removeClass('hidden');
          setTimeout(function () {
            $notice.addClass('hidden');
          }, 10000);

          form.clear();

          if (!$commentsList.data('commentsModerated')) {
            $commentsList.load(document.location.pathname + ' [data-comments-list] > div');
          };
        },
        onError: function (response, form) {
          form.markErrors(response.errors);
        },
      };
      //var $form = InSalesUI.Form.create($('#comment_form'), _commentForm);

      $(document).on('click', '.js-comments-toggle', function(event) {
        event.preventDefault();
        console.log('>>>>');

        alertify.modal({
          formDefination: _commentForm
        }).set('title', '{{ messages.button_review }}' );
      });
    });
  {% endif %}

  {% if template == 'product' %}
      (function(){
        var _reviewYandexCaptchaId = null;
        var _reviewCaptchaToken = null;

        var _reviewForm = {
          form: {
            classes: 'is-reviews',
          },
          fields: [
            {
              title: '{{ messages.field_rating }}',
              name: 'rating',
              type: 'rating',
              rating: 5
            },
            {
              title: '{{ messages.field_text }}',
              type: 'textarea',
              name: 'content',
              required: true,
            },
            {
              title: '{{ messages.field_name }}',
              name: 'author',
              required: true,
            },
            {
              title: '{{ messages.field_email }}',
              name: 'email',
              required: true
            }
          ],

          sendTo: function(data, options) {
            var token = _reviewCaptchaToken || '';
            if (!token && window.smartCaptcha && _reviewYandexCaptchaId !== null) {
              try { token = window.smartCaptcha.getResponse(_reviewYandexCaptchaId) || ''; } catch(e) {}
            }

            if (!token) {
              $('.ajs-dialog .reviews-captcha-row').css('outline', '2px solid red');
              alertify.error('Пожалуйста, подтвердите, что вы не робот');
              return $.Deferred().reject({ errors: {} });
            }
            $('.ajs-dialog .reviews-captcha-row').css('outline', '');

            return $.ajax({
              url: '{{ product.url }}/reviews.json',
              type: 'POST',
              dataType: 'json',
              data: {
                'review[rating]': data.rating || 5,
                'review[content]': data.content || '',
                'review[author]': data.author || '',
                'review[email]': data.email || '',
                'review[yandex-smart-token]': token,
                'lang': ''
              }
            });
          },
          messages: {
            success: '{{ messages.review_is_added }}'
          },
          onValid: function (response, form) {
            var $notice = $('.js-reviews-notice-success');
            alertify.set('notifier','position', 'top-right');
            $notice.removeClass('hidden');
            setTimeout(function () {
              $notice.addClass('hidden');
            }, 10000);

            if (window.smartCaptcha && _reviewYandexCaptchaId !== null) {
              window.smartCaptcha.reset(_reviewYandexCaptchaId);
            }
            form.clear();
          },
          onErrors: function (response, form) {
            if (window.smartCaptcha && _reviewYandexCaptchaId !== null) {
              window.smartCaptcha.reset(_reviewYandexCaptchaId);
            }
            alertify.error('Ошибка при отправке отзыва. Попробуйте ещё раз.');
          }
        };

        function initReviewYandexCaptcha() {
          if (!window.smartCaptcha) return;
          var $form = $('.ajs-dialog .form.is-reviews');
          if (!$form.length || $form.find('.reviews-yandex-captcha').length) return;

          var $captchaRow = $(
            '<div class="form-row is-required is-captcha reviews-captcha-row">' +
              '<div class="reviews-yandex-captcha"></div>' +
            '</div>'
          );
          $form.find('.form-controls-wrapper').before($captchaRow);

          var sitekey = (Shop.config.config || {}).yandex_captcha_key || '';

          _reviewCaptchaToken = null;
          _reviewYandexCaptchaId = window.smartCaptcha.render(
            $form.find('.reviews-yandex-captcha')[0],
            {
              sitekey: sitekey,
              callback: function(token) {
                _reviewCaptchaToken = token;
                $('.ajs-dialog .reviews-captcha-row').css('outline', '');
              },
              'expired-callback': function() { _reviewCaptchaToken = null; },
              'error-callback': function() { _reviewCaptchaToken = null; }
            }
          );
        }

        $(document).on('click', '.js-reviews-toggle', function (event) {
          event.preventDefault();

          _reviewYandexCaptchaId = null;
          alertify.modal({
            formDefination: _reviewForm
          }).set('title', '{{ messages.button_review }}' );

          setTimeout(initReviewYandexCaptcha, 300);
        });
      }());
  {% endif %}
</script>

{% if template contains 'page' %}
  <script type="text/javascript">
    $(function () {
      if (!$('.js-form-feedback').length) return;

      // EventBus — платформа генерирует событие при успешной отправке data-feedback-form-wrapper форм
      EventBus.subscribe('send-feedback:insales:ui_feedback', function() {
        if (!$('.js-form-feedback').length) return;
        var $msg = $('.js-feedback-success');
        $msg.stop(true).fadeIn(300);
        setTimeout(function() { $msg.fadeOut(400); }, 8000);
      });
    });
  </script>
  {% if page.url contains 'service-centers' %}
    {% comment %} <script src="{{ 'service-centers.js' | asset_url }}" charset="utf-8"></script> {% endcomment %}
    {% comment %} <script src="{{ 'pagination.min.js' | asset_url }}" charset="utf-8"></script> {% endcomment %}
  {% endif %}
{% endif %}

{% if template contains 'page.services' %}
  <script>
    $('.js-services-product-item').on('click', function () {
      var $this = $(this);

      $this.closest('.page-services__products').hide();
      $('.page-services__heading').hide();

      $('.page-services__product').show();
      $('.page-services__product .page-services__product__item__image').find('img').attr('src', $this.data('image'));
      $('.page-services__product .page-services__product__item__title').html($this.data('title'));

      $('.page-services__problems').show().data('product-title', $this.data('title'));
      $('.page-services__problems .page-services__problems__items').html($this.find('.js-problems-list').html());
      $('.page-services__feedback').hide();
      $('#feedback_subject_ser').val('');
    });

    $(document).on('click', '.page-services__problems__item', function () {
      var productTitle = $('.page-services__problems').data('product-title') || '';
      var problemTitle = $(this).find('.page-services__problems__item__title').html();

      $(this).closest('.page-services__problems__items').find('.page-services__problems__item').removeClass('active');
      $(this).addClass('active');

      $('#feedback_subject_ser').val(productTitle + ' - ' + problemTitle);
      $('.page-services__feedback').show();
      $('.js-services-feedback-success').hide();
      $('.page-services__feedback [name="name"]').focus();
    });

    EventBus.subscribe('send-feedback:insales:ui_feedback', function (data) {
      if (!data.form || !data.form.hasClass('js-widget-services-feedback')) {
        return;
      }

      var $msg = $('.js-services-feedback-success');
      $msg.stop(true).fadeIn(300);
      setTimeout(function () { $msg.fadeOut(400); }, 8000);
    });
  </script>
{% endif %}

