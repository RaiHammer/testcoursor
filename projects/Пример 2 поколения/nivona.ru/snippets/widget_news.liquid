{% if blogs.news.articles.size > 0 %}
	<section class="section-news-offers">
        <div class="section-news-offers__title">
            <a href="{{ blogs.news.url }}" title="{{ blogs.news.title }}" class="section-news-offers__link">
                <span>{{ blogs.news.title }}</span>
            </a>
        </div>
        <div class="section-news-offers__items blog-acticle">
            <div class="container">
                <div class="blog-acticle__items">
                    {% for article in blogs.news.articles limit: 3 %}
                        {% include 'article_preview' %}
                    {% endfor %}
                </div>
            </div>
        </div>
	</section>
{% endif %}