   function check_omni_track(track_number) {
   
   console.log("check_omni_track()");
    // скрыть ошибку и инфо
    $("#omni_tracking_info").hide();
    $("#omni_tracking_error_massage").hide();
    // показать лоадер
    $("#omni_tracking_loader").show();

    // получить данные
    var omni_tracking_url= "https://is.omnicrm.ru/insales-proxy/get-track-info/tmall-brands/?track_number="+track_number;
     // ="https://is-dev.omnicrm.ru/insales-proxy/get-track-info/tmall/?track_number="+track_number;
    // omni_tracking_url='https://static-eu.insales.ru/files/1/851/8717139/original/test-order1.json';
    //if (track_number == '123') omni_tracking_url="https://static-ru.insales.ru/files/1/851/8717139/original/test-order1.json_no";
    // если ошибка Ajax
    // если ошибка Omni
    // если не ошибка Omni
    // распарсить данные
    $.ajax({
        url: omni_tracking_url,
        success : function(data) {
                //console.log(data);
                var extended_fields=omniOrderPars(data);
                console.log(extended_fields);

                    $("#omni_tracking_order_number").text(data.result.id);
                    $("#omni_tracking_delivery_region").text(region_map[extended_fields['deliveryRegion']]);  // тут должен быть меппинг region_map
                    $("#omni_tracking_delivery_city").text(extended_fields['deliveryCityName']); 
                    $("#omni_tracking_order_address").text(data.result.delivery.address.street +
                        ( (data.result.delivery.address.house != '') ? ( ', д. ' + data.result.delivery.address.house ) : '' ) +
                        ( (data.result.delivery.address.structure != '') ? ( ', корп. ' + data.result.delivery.address.structure ) : '' ) +
                        ( (data.result.delivery.address.building != '') ? ( ', стр. ' + data.result.delivery.address.building ) : '' ) +
                        ( (data.result.delivery.address.flat != '') ? ( ', кв. ' + data.result.delivery.address.flat ) : '' ) 
                    );

                    var delivery_date= new Date(data.result.delivery.date);
                    delivery_date.setHours(0);
                    var delivery_info=getInfoForDeliveryType(extended_fields['deliveryVariant']);

                    $("#omni_tracking_order_date").text(delivery_date.toLocaleString("ru",  {  year: 'numeric', month: 'numeric', day: 'numeric',} ) ); // тут надо перевернуть дату
                        //' (c' + data.result.delivery.time.from + ' до ' + data.result.delivery.time.till + ')';
                    $("#omni_tracking_delivery_type").text(delivery_info.type);
                    $("#omni_tracking_delivery_provider").text(delivery_info.provider);		                    
                    if( delivery_info.provider_code == 'yado' ) {
                         if(status_canceld[data.result.externalStateId] === undefined && (delivery_date<=Date.now()) ) {
                            $("#omni_tracking_order_status").text("Пердан в доставку");
                            $("#omni_tracking_order_date_label").text('Дата передачи заказа с службу доставки');
                            $("#omni_tracking_order_delivery_provider_number").text(extended_fields['strizhOrderId']);
                            $("#omni_tracking_order_delivery_provider_number").parent().show();
                           
                         } else {
                            $("#omni_tracking_order_status").text( (status_map[data.result.externalStateId] === undefined )?("В обработке"):status_map[data.result.externalStateId]  ); // тут должен быть меппинг
                            $("#omni_tracking_order_date_label").text('Планируемая дата передачи заказа с службу доставки');
                            $("#omni_tracking_order_delivery_provider_number").parent().hide();
                            $("#omni_tracking_order_msw").show();
                         }
                    } else {
                        $("#omni_tracking_order_date_label").text('Дата доставки');
                        $("#omni_tracking_order_status").text( ( ( extended_fields['strizhStatusID'] === undefined ) || (extended_fields['strizhStatusID'] < 211) ) ? ((status_map[data.result.externalStateId] === undefined )?("В обработке"):status_map[data.result.externalStateId] ): ( (extended_fields['strizhStatusID'] < 219 ) ? ("Передан в доставку") :  ( "Передан в доставку (" + extended_fields['strizhStatusName'] + ")") ) ); // тут должен быть меппинг
                        $("#omni_tracking_order_delivery_provider_number").parent().hide();
                        $("#omni_tracking_order_msw").hide();
                   }

                        //data.result.externalProviderId
                        //extended_fields['deliveryVariant']

                $("#omni_tracking_loader").hide();
                $("#omni_tracking_info").show();	
        },
    	error: function(data) {
             	console.log("check_omni_track: error");     	
                $("#omni_tracking_loader").hide();
                $("#omni_tracking_error_massage").show();	
        }
     });
  }

   function omniOrderPars(data) {
       var extended_fields={};
       console.log(data);
       data.result.propertyValues.forEach(function(item, i, arr) {
        if ( !(item.externalPropertyId === undefined) )  {
            if ( !(item.referenceValue === undefined) )  extended_fields[item.externalPropertyId] = item.externalReferenceValue;
            if ( !(item.stringValue === undefined) )     extended_fields[item.externalPropertyId] = item.stringValue;
            if ( !(item.dateValue === undefined) )       extended_fields[item.externalPropertyId] = item.dateValue;
            if ( !(item.booleanValue === undefined) )    extended_fields[item.externalPropertyId] = item.booleanValue;  
            if ( !(item.dateTimeValue === undefined) )   extended_fields[item.externalPropertyId] = item.dateTimeValue; 
            if ( !(item.numberValue === undefined) )     extended_fields[item.externalPropertyId] = item.NumberValue; 
        }
       });

       return extended_fields;
  };
  function getInfoForDeliveryType(delivery_type) {
   
    var delivery_info = {
      type: '',
      provider: '',
      provider_code: null
    };
 	var delivery_type_map = {
   		'strizh':  {
     			type: 'courer',
        		provider: 'strizh'
   		},
   		'strizh_pvz': {
     			type: 'pvz',
        		provider: 'strizh'
   		},
   		'yandex_delivery': {
     			type: 'courer',
        		provider: 'yado'
   		},
   		'yandex_delivery_pvz': {
     			type: 'pvz',
        		provider: 'yado'
   		},
        'dellin' : {
     			type: 'courer',
        		provider: 'dellin'
   		}
 	};
 	var delivery_provider_name = {
  		'strizh' : 'СД "Стриж"',
  		'yado':  'Яндекс.Доставка',
  		'dellin' : 'Деловые линии'
 	};
 	var delivery_type_name = {
  		'pvz' : 'Доставка в пункт выдачи заказов',
  		'courer':  'Доставка курьером по адресу'
 	};
    if (delivery_type != undefined && delivery_type_map[delivery_type] != undefined) {
      	if (delivery_type_map[delivery_type].type != undefined && delivery_type_name[delivery_type_map[delivery_type].type] != undefined)  delivery_info.type=delivery_type_name[delivery_type_map[delivery_type].type];
      	if (delivery_type_map[delivery_type].provider != undefined) {
        	delivery_info.provider_code=delivery_type_map[delivery_type].provider;
        	if(delivery_provider_name[delivery_type_map[delivery_type].provider] != undefined)  delivery_info.provider=delivery_provider_name[delivery_type_map[delivery_type].provider];
      	}
    }
    return delivery_info;
 }

