              </svg>
            </span>
            <span class="is-about-skidki__text">{{ characteristic.name }}</span>
            <div class="is-about-skidki__popup">
              {% for block in block_lists.block-sale-panel.blocks %}
                {% if block.show-sale %}

                  {% comment %} список Категорий, категорий может быть больше чем 1 {% endcomment %}
                  {% for kateigor in block.collection-sale-3 %}

                    {% comment %} Сверяем категорию товара с категориями из блока {% endcomment %}
                    {% if product.canonical_collection.handle != 'all' %}
                      {% assign canon = product.canonical_collection.handle %}
                    {% else %}
                    {% comment %} товары заведены "не одинаково", поэтому это второй сценарий обработки категории {% endcomment %}
                      {% for collec in product.collections %}
                        {% unless collec.handle != kateigor.handle %}
                          {% assign canon = collec.handle %}
                        {% endunless %}
                      {% endfor %}
                    {% endif %}

                    {% comment %} вывод текста ПО СООТВЕТСТВИЮ КАТЕГОРИЙ {% endcomment %}
                    {% if kateigor.handle == canon or kateigor.handle == 'all' %}
                      <div class="sale-item">
                        <span class="sale-item__text">{{ block.text-sale }}</span>
                      </div>
                    {% endif %}
                  {% endfor %}

                {% endif %}
              {% endfor %}
            </div>
          </span>

        {% comment %} ❤  иend about-skidki ODX-1789 ❤  {% endcomment %}
        {% else %}
            <span class="label is-{{ characteristic.handle }}">
              {{ characteristic.name }}
            </span>
        {% endif %}
      {% endfor %}
    {% endif %}

    {% comment %}
      {% assign max_discount = 0 %}
      {% for variant in product.variants %}
        {% if variant.old_price and variant.price < variant.old_price %}
          {% assign discount = variant.price | divided_by: variant.old_price | times: -100 | plus: 100 | round: 0 %}
          {% if max_discount < discount %}{% assign max_discount = discount %}{% endif %}
        {% endif %}
      {% endfor %}

      {% unless max_discount == 0 or bundle_component %}
        <span class="label is-discount js-label-discount">
          {% if product.old_price_varies? %}
            {{ messages.label_to | downcase }}
          {% endif %}
          {{ max_discount }}%
        </span>
      {% endunless %}
    {% endcomment %}

    {% if product.is_bundle and template contains 'product' %}
      <span class="label is-bundle">
        {{ messages.bundle }}
      </span>
    {% endif %}

    {% if product.is_bundle and product.bundle_discount > 0 and max_discount == 0 %}
      <span class="label is-bundle-discount">
        {{ messages.label_economy }}
        {{ product.bundle_discount | money }}
      </span>
    {% endif %}
   {% if discount > 0 %}
     <span class="label is-discount">
         -{{ discount }}%
     </span>
   {% endif %}

    {% unless product.available %}
      {% case settings.product_not_available %}
        {% when 'preorder' %}
          {% assign label_text = messages.preorder %}
          {% assign label_class = 'is-preorder' %}
        {% when 'hidden' %}
          {% assign label_text = messages.product_not_available %}
          {% assign label_class = 'not-available' %}
      {% endcase %}

      {% unless bundle_component or settings.product_not_available == 'shown' %}
        {% if label_text %}
          <span class="label {{ label_class }}">
            {{ label_text }}
          </span>
        {% endif %}
      {% endunless %}
    {% endunless %}
  </div>
{% endif %}

{% assign show_labels = null %}
{% assign label_text = null %}
{% assign label_class = null %}
{% assign max_discount = null %}
{% assign discount = null %}
{% assign max_discount = null %}
