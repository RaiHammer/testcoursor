{% assign show_labels = false %}
{% assign prop_handle = property | default: 'label' %}
{% assign labels_list = product.properties[prop_handle] %}

{% if labels_list or product.variants.first.old_price %}
  {% unless bundle_component %}
    {% assign show_labels = true %}
  {% endunless %}
{% endif %}

{% if product.is_bundle and product.bundle_discount > 0 %}
  {% assign show_labels = true %}
{% endif %}

{% unless product.available %}
  {% assign show_labels = true %}
{% endunless %}

{% if show_labels %}
  <div class="product-labels labels-list" data-labels-id="{{ product.id }}">
    {% if labels_list %}
      {% for characteristic in labels_list.characteristics %}
        {% if characteristic.handle == 'gift-coffee' %}
          {% if settings.actions_bundle_change_position_enable == '1' and product.fields[settings.actions_bundle_change_position_field_handle].value.size > 0 %}
                <a href="/blogs/actions/kofe-v-podarok" class="label is-{{ characteristic.handle }}">
                  {{ characteristic.name }}
                </a>
          {% endif %}
        {% comment %} ❤ иbegin about-skidki ODX-1789 ❤ {% endcomment %}
        {% elsif characteristic.handle == 'about-skidki' %}
          <span class="label is-{{ characteristic.handle }}">
            <span class="is-about-skidki__icon">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
