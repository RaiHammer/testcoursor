			{% if account.captcha_type == 'google' and settings.feedback_captcha_enabled %}
				<form class="form form--modal js-form-call" action="/client_account/feedback" accept-charset="UTF-8" method="post" data-response-modal="call_thx" data-captcha="google">
					<div class="row">
