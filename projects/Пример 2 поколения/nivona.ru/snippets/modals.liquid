					</div>
				</form>
			{% elsif account.captcha_type == 'yandex' %}
				<form class="form form--modal js-form-call" action="/client_account/feedback" accept-charset="UTF-8" method="post" data-response-modal="call_thx" data-captcha="yandex" data-feedback-form-wrapper>
					{% comment %} <div class="row">
						<div class="col-xs-12">
							<div
								data-feedback-form-success='{"showTime": 10000}'
								class="success-message"
							>Успешно отправлено</div>
						</div>
					</div> {% endcomment %}
