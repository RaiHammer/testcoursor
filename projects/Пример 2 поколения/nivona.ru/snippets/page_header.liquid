	<div class="page-head">
		<div class="container">
			<div class="row">
				<div class="col-xs-12">
          {% if template contains 'order' %}

          {% else %}
            {% include "breadcrumb", home_title: 'Главная' %}
          {% endif %}
				</div>

        {% if template contains 'cart' %}
          {% assign page_title = 'Ваша корзина' %}

        {% elsif template contains 'checkout' %}
          {% assign page_title = 'Ваша корзина' %}

        {% elsif template contains 'search' %}
          {% assign page_title = messages.search_title %}

        {% elsif template contains 'compare' %}
          {% assign page_title = messages.comparison_title %}

        {% elsif template contains 'index' %}
          {% assign page_title = page.title | editable %}

        {% elsif template contains 'collection' %}
          {% comment %}
          {% if filter.title %}
            {% assign page_title = filter.title | editable %}
          {% else %}
            {% assign page_title = collection.title | editable %}
          {% endif %}
          {% endcomment %}

        {% elsif template contains 'product' %}
          {% comment %}
            {% assign page_title = product.title | editable %}
          {% endcomment %}

        {% elsif template contains 'blog' %}
          {% comment %}
          {% assign page_title = blog.title | editable %}
          {% endcomment %}

        {% elsif template contains 'article' %}
          {% comment %}
            {% assign page_title = article.title | editable %}
          {% endcomment %}

        {% elsif template contains 'page' %}
          {% assign page_title = page.title | editable %}
                  
        {% elsif template contains 'account' %}
          {% assign page_title = yititle %}

        {% elsif template contains 'order' %}
          {% assign page_title = '' %}
        {% endif %}

          <div class="col-xs-12">
          <!--  <h1 class="page-head__title">
              {{ page_title }}
            </h1>-->
          </div>
			</div>
		</div>
	</div>
