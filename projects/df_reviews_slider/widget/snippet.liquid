                    {% assign df_review_sort_ts = review.created_at | date: '%s' %}

                    {% assign df_review_stars = '' %}

                    {% for i in (1..5) %}

                      {% if i <= review_rating %}

                        {% assign df_review_stars = df_review_stars | append: '★' %}

                      {% else %}

                        {% assign df_review_stars = df_review_stars | append: '☆' %}

                      {% endif %}

                    {% endfor %}

                    {% assign df_review_meta = review | json | replace: '"', '&quot;' %}

                    <div class="swiper-slide df-reviews__slide" data-rating="{{ review_rating }}" data-source="insales" data-sort-ts="{{ df_review_sort_ts }}" data-df-review-meta="{{ df_review_meta }}"{% if review.id %} data-review-id="{{ review.id }}"{% endif %}{% if review.image.original_url %} data-photo-urls="[&quot;{{ review.image.original_url }}&quot;]"{% if review.image.medium_url.size > 0 %} data-photo-previews="[&quot;{{ review.image.medium_url }}&quot;]"{% endif %}{% endif %} itemprop="review" itemscope itemtype="http://schema.org/Review">

                      <div class="df-reviews__avatar df-reviews__avatar--placeholder">{{ review.author | strip | slice: 0, 1 | default: '?' }}</div>

                      <div class="df-reviews__author" itemprop="author" itemscope itemtype="http://schema.org/Person"><span itemprop="name">{{ review.author }}</span></div>

                      {% unless df_hide_date == 'true' %}

                        <time class="df-reviews__date" datetime="{{ review.created_at }}">{{ review.created_at | date: '%d.%m.%Y' }}</time>

                      {% endunless %}

                      <div class="df-reviews__stars" aria-label="{{ review_rating }} из 5" itemprop="reviewRating" itemscope itemtype="http://schema.org/Rating"><meta itemprop="ratingValue" content="{{ review_rating }}"><meta itemprop="bestRating" content="5">{{ df_review_stars }}</div>

                      <p class="df-reviews__text" itemprop="reviewBody">{{ review.content }}</p>

                      {% unless df_hide_source == 'true' %}<span class="df-reviews__source">InSales</span>{% endunless %}

                    </div>

                  {% endif %}

                {% endfor %}

              {% else %}

              {% prefetch account.reviews_not_spam limit df_insales_limit, offset: reviews_start, sort: 'date_desc' %}

              {% for review in account.reviews_not_spam %}

                {% assign review_rating = review.rating | default: 5 | plus: 0 %}

                {% if review_rating >= df_min_rating %}

                  {% assign df_has_slide_content = true %}

                  {% assign df_review_sort_ts = review.created_at | date: '%s' %}

                  {% assign df_review_stars = '' %}

                  {% for i in (1..5) %}

                    {% if i <= review_rating %}

                      {% assign df_review_stars = df_review_stars | append: '★' %}

                    {% else %}

                      {% assign df_review_stars = df_review_stars | append: '☆' %}

                    {% endif %}

                  {% endfor %}

                  {% assign df_review_meta = review | json | replace: '"', '&quot;' %}

                  <div class="swiper-slide df-reviews__slide" data-rating="{{ review_rating }}" data-source="insales" data-sort-ts="{{ df_review_sort_ts }}" data-df-review-meta="{{ df_review_meta }}"{% if review.id %} data-review-id="{{ review.id }}"{% endif %}{% if review.image.original_url %} data-photo-urls="[&quot;{{ review.image.original_url }}&quot;]"{% if review.image.medium_url.size > 0 %} data-photo-previews="[&quot;{{ review.image.medium_url }}&quot;]"{% endif %}{% endif %} itemprop="review" itemscope itemtype="http://schema.org/Review">

                    <div class="df-reviews__avatar df-reviews__avatar--placeholder">{{ review.author | strip | slice: 0, 1 | default: '?' }}</div>

                    <div class="df-reviews__author" itemprop="author" itemscope itemtype="http://schema.org/Person"><span itemprop="name">{{ review.author }}</span></div>

                    {% unless df_hide_date == 'true' %}

                      <time class="df-reviews__date" datetime="{{ review.created_at }}">{{ review.created_at | date: '%d.%m.%Y' }}</time>

                    {% endunless %}

                    <div class="df-reviews__stars" aria-label="{{ review_rating }} из 5" itemprop="reviewRating" itemscope itemtype="http://schema.org/Rating"><meta itemprop="ratingValue" content="{{ review_rating }}"><meta itemprop="bestRating" content="5">{{ df_review_stars }}</div>

                    <p class="df-reviews__text" itemprop="reviewBody">{{ review.content }}</p>

                    {% unless df_hide_source == 'true' %}<span class="df-reviews__source">InSales</span>{% endunless %}

                  </div>

                {% endif %}

              {% endfor %}

              {% endprefetch %}

              {% endif %}

            {% endif %}

          {% endunless %}

          {% unless df_hide_yandex == 'true' %}

            {% if df_yandex_trimmed != blank %}

              {{ df_yandex_markup }}

              {% assign df_has_slide_content = true %}

            {% endif %}

          {% endunless %}

          {% endif %}

          {% if df_has_slide_content == false %}

            <div class="swiper-slide df-reviews__slide df-reviews__slide--empty{% if df_on_product_page %} df-reviews__slide--product-empty{% endif %}">

              {% if df_on_product_page %}

                {% assign df_empty_msg = widget_settings['product-empty-message'] | default: widget_settings.product_empty_message | default: 'Пока нет отзывов на этот товар. Станьте первым — поделитесь впечатлениями!' %}

              {% else %}

                {% assign df_empty_msg = widget_settings['empty-message'] | default: widget_settings.empty_message %}

              {% endif %}

              <p class="df-reviews__empty">{{ df_empty_msg }}</p>

              {% if df_on_product_page and df_show_write %}

                <button type="button" class="df-reviews__write-btn df-reviews__write-btn--empty" data-df-reviews-write-btn>

                  {{ messages.review_write_new | default: 'Оставить отзыв' }}

                </button>

              {% endif %}

            </div>

          {% endif %}

        </div>



        {% if df_layout == 'slider' or df_layout == 'spotlight' %}

          <div class="swiper-button-next df-reviews__arrow df-reviews__arrow--next" aria-label="Следующий отзыв"></div>

          <div class="swiper-pagination df-reviews__pagination"></div>

        {% endif %}

      </div>



      {% if df_layout == 'masonry' %}

        <button type="button" class="df-reviews__more" data-df-reviews-more hidden>Показать ещё</button>

      {% endif %}

      {% if account.reviews_enabled? and df_hide_insales != 'true' and df_use_legacy_slides == false and df_layout == 'masonry' and df_insales_server_pagination == 'true' and df_insales_batch_page < df_insales_page_count %}

        <div class="df-reviews__insales-pagination" data-df-insales-pagination>

          <button type="button" class="df-reviews__insales-loadmore" data-df-insales-loadmore data-url="{{ df_insales_loadmore_url }}">Загрузить ещё</button>

        </div>

      {% endif %}



      {% if df_layout == 'masonry' or df_layout == 'grid' or df_layout == 'list' %}

        <nav class="df-reviews__pages" data-df-reviews-pages{% if df_layout == 'masonry' and df_insales_server_pagination != 'true' %} hidden{% elsif df_layout == 'grid' or df_layout == 'list' %} hidden{% endif %} aria-label="Страницы отзывов">

          <button type="button" class="df-reviews__page-arrow" data-df-page-prev aria-label="Предыдущая страница">‹</button>

          <div class="df-reviews__pages-list" data-df-pages-list></div>

          <button type="button" class="df-reviews__page-arrow" data-df-page-next aria-label="Следующая страница">›</button>

        </nav>

      {% endif %}

      {% assign cta_text = widget_settings['cta-text'] | default: widget_settings.cta_text %}

      {% assign cta_url = widget_settings['cta-url'] | default: widget_settings.cta_url %}

      {% assign df_actions_floating = false %}

      {% if df_layout == 'masonry' or df_layout == 'grid' %}

        {% assign df_actions_floating = true %}

      {% endif %}

      {% if df_show_write or cta_text != blank and cta_url != blank %}

        {% unless df_actions_floating %}

          <div class="df-reviews__actions df-reviews__actions--inline">

            {% if df_show_write %}

              <button type="button" class="df-reviews__write-btn" data-df-reviews-write-btn>

                {{ messages.review_write_new | default: 'Оставить отзыв' }}

              </button>

            {% endif %}



            {% if cta_text != blank and cta_url != blank %}

              <a class="df-reviews__cta" href="{{ cta_url }}">{{ cta_text }}</a>

            {% endif %}

          </div>

        {% endunless %}

      {% endif %}

    </div>



    {% if df_show_write or cta_text != blank and cta_url != blank %}

      {% if df_actions_floating %}

        <div class="df-reviews__actions df-reviews__actions--floating">

          {% if df_show_write %}

            <button type="button" class="df-reviews__write-btn" data-df-reviews-write-btn>

              {{ messages.review_write_new | default: 'Оставить отзыв' }}

            </button>

          {% endif %}



          {% if cta_text != blank and cta_url != blank %}

            <a class="df-reviews__cta df-reviews__cta--floating" href="{{ cta_url }}">{{ cta_text }}</a>

          {% endif %}

        </div>

      {% endif %}

    {% endif %}

  </div>



  {% if df_show_write %}

    <div class="df-reviews__form-modal" data-df-reviews-form-modal hidden>

      <div class="df-reviews__form-backdrop" data-df-form-close></div>

      <div class="df-reviews__form-dialog" role="dialog" aria-modal="true" aria-label="{{ messages.give_feedback | default: 'Оставить отзыв' }}">

        <button type="button" class="df-reviews__form-close" data-df-form-close aria-label="Закрыть">×</button>

        <div class="df-reviews__form-header">

          <div class="df-reviews__form-title">{{ messages.give_feedback | default: 'Оставить отзыв' }}</div>

        </div>

        <form data-reviews-form-wrapper='{"reviews_moderated": {{ account.reviews_moderated? }} , "url": "{{ df_form_wrapper_url }}" }' class="df-reviews__form" method="post" action="{{ df_form_action }}" enctype="multipart/form-data">

          {% if df_on_product_page %}

            <input type="hidden" name="review[product_id]" value="{{ product.id }}">

          {% endif %}

          {% assign success_message = messages.review_is_added %}

          {% if account.reviews_moderated? %}

            {% assign success_message = messages.review_is_added_moderated %}

          {% endif %}

          <div data-reviews-form-success='{"showTime": 10000, "message": "{{ success_message }}", "reloadPage": false }' class="df-reviews__form-success"></div>

          <div id="review_form" class="df-reviews__form-body">

            <div class="df-reviews__form-fields">

              <div class="df-reviews__form-row df-reviews__form-row--rating">

                <div data-reviews-form-field-area class="df-reviews__star-rating-wrap">

                  <div class="df-reviews__star-rating">

                    {% assign r = 5 %}

                    {% for i in (1..5) %}

                      <input

                        data-reviews-form-field

                        name="review[rating]"

                        id="df-star{{ r }}-{{ widgetDrop.id }}"

                        type="radio"

                        class="df-reviews__star-radio"

                        value="{{ r }}"

                      />

                      <label title="{{ r }}" for="df-star{{ r }}-{{ widgetDrop.id }}" class="df-reviews__star-label">★</label>

                      {% assign r = r | minus: 1 %}

                    {% endfor %}

                  </div>

                  <div data-reviews-form-field-error class="df-reviews__field-error"></div>

                </div>

              </div>



              <div data-reviews-form-field-area class="df-reviews__form-row {% if review.errors contains 'author' %}is-error{% endif %}">

                <label class="df-reviews__form-label">{{ messages.name }} <span class="df-reviews__required">*</span></label>

                <input

                  data-reviews-form-field='{"isRequired": true, "errorMessage": "{{ messages.name_error | escape }}"}'

                  name="review[author]"

                  placeholder="{{ messages.name }}"

                  value="{{ review.author }}"

                  type="text"

                  class="df-reviews__form-input"

                />

                <div data-reviews-form-field-error class="df-reviews__field-error"></div>

              </div>



              <div data-reviews-form-field-area class="df-reviews__form-row {% if review.errors contains 'email' %}is-error{% endif %}">

                <label class="df-reviews__form-label">{{ messages.field_email }} <span class="df-reviews__required">*</span></label>

                <input

                  data-reviews-form-field='{"isRequired": true, "errorMessage": "{{ messages.email_error | escape}}"}'

                  name="review[email]"

                  placeholder="{{ messages.field_email }}"

                  value="{{ review.email }}"

                  type="text"

                  class="df-reviews__form-input"

                />

                <div data-reviews-form-field-error class="df-reviews__field-error"></div>

              </div>



              <div data-reviews-form-field-area class="df-reviews__form-row {% if review.errors contains 'content' %}is-error{% endif %}">

                <label class="df-reviews__form-label">{{ messages.review }} <span class="df-reviews__required">*</span></label>

                <textarea

                  data-reviews-form-field='{"isRequired": true, "errorMessage": "{{ messages.please_enter_message | escape }}"}'

                  name="review[content]"

                  placeholder="{{ messages.review }}"

                  class="df-reviews__form-input df-reviews__form-textarea"

                >{{ review.content }}</textarea>

                <div data-reviews-form-field-error class="df-reviews__field-error"></div>

              </div>



              {% if account.reviews_images_enabled? %}

                <div data-reviews-form-field-area class="df-reviews__form-row {% if review.errors contains 'image.image' %}is-error{% endif %}">

                  <label class="df-reviews__form-label df-reviews__form-file-label">

                    <span data-df-review-file-name data-default-label="{{ messages.add_photo }}">{{ messages.add_photo }}</span>

                    <input

                      data-reviews-form-image

                      type="file"

                      class="df-reviews__form-file-input"

                      name="review[image_attributes][image]"

                    />

                  </label>

                  <div data-reviews-form-field-error class="df-reviews__field-error"></div>

                </div>

              {% endif %}



              {% if account.captcha_type == 'google' %}

                <div data-reviews-form-field-area class="df-reviews__form-row {% if review.errors contains 'captcha_solution' %}is-error{% endif %}">

                  <div

                    data-recaptcha-type="invisible"

                    data-reviews-form-recaptcha='{"isRequired": true, "errorMessage": "{{ messages.recaptcha_error | escape }}"}'

                    id="df-captcha-google-{{ widgetDrop.id }}"

                    class="df-reviews__form-captcha"

                  ></div>

                  <div data-reviews-form-field-error class="df-reviews__field-error"></div>

                </div>

              {% elsif account.captcha_type == 'yandex' %}

                <div data-reviews-form-field-area class="df-reviews__form-row {% if review.errors contains 'captcha_solution' %}is-error{% endif %}">

                  <div

                    data-yandex-captcha-type="invisible"

                    data-reviews-form-yandex-captcha='{"isRequired": true, "errorMessage": "{{ widget_messages.yandex_captcha_error | escape }}"}'

                    id="df-captcha-yandex-{{ widgetDrop.id }}"

                    class="df-reviews__form-captcha df-reviews__form-yandex-captcha"

                  ></div>

                  <div data-reviews-form-field-error class="df-reviews__field-error"></div>

                </div>

              {% endif %}



              <div class="df-reviews__form-controls">

                <button type="submit" class="df-reviews__form-submit">{{ messages.give_feedback | default: 'Отправить' }}</button>

              </div>

            </div>



            {% if account.reviews_moderated? %}

              <p class="df-reviews__form-moderation">{{ messages.reviews_are_moderated }}</p>

            {% endif %}



            {%- if editor_mode? -%}

              <div data-reviews-form-field-area class="df-reviews__form-row">

                <label class="df-reviews__form-label">Дата отзыва</label>

                <input type="datetime-local" name="review[created_at]" value="" class="df-reviews__form-input">

              </div>

            {%- endif -%}

          </div>

        </form>

      </div>

    </div>

  {% endif %}

  <div class="df-reviews__modal" data-df-reviews-modal hidden>

    <div class="df-reviews__modal-backdrop" data-df-modal-close></div>

    <div class="df-reviews__modal-dialog" role="dialog" aria-modal="true" aria-label="Отзыв">

      <button type="button" class="df-reviews__modal-close" data-df-modal-close aria-label="Закрыть">×</button>

      <div class="df-reviews__modal-head">

        <div class="df-reviews__modal-avatar"></div>

        <div class="df-reviews__modal-author"></div>

      </div>

      <div class="df-reviews__modal-meta">

        <span class="df-reviews__modal-date"></span>

        <span class="df-reviews__modal-stars"></span>

        <div class="df-reviews__modal-product"></div>

      </div>

      <div class="df-reviews__modal-photos"></div>

      <p class="df-reviews__modal-text"></p>

      <span class="df-reviews__modal-source"></span>

    </div>

  </div>

  <div class="df-reviews__lightbox" data-df-reviews-lightbox hidden>

    <div class="df-reviews__lightbox-backdrop" data-df-lightbox-close></div>

    <div class="df-reviews__lightbox-dialog" role="dialog" aria-modal="true" aria-label="Просмотр фото">

      <button type="button" class="df-reviews__lightbox-close" data-df-lightbox-close aria-label="Закрыть">×</button>

      <div class="df-reviews__lightbox-swiper swiper">

        <div class="swiper-wrapper df-reviews__lightbox-wrapper"></div>

        <div class="swiper-button-prev df-reviews__lightbox-prev"></div>

        <div class="swiper-button-next df-reviews__lightbox-next"></div>

        <div class="swiper-pagination df-reviews__lightbox-pagination"></div>

      </div>

    </div>

  </div>

</div>


